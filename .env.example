# ForwardCheck-AI Environment Variables

# Required
ANTHROPIC_API_KEY=your-anthropic-api-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Search APIs (optional — investigations will skip search if not set)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/forwardcheck.db

# WhatsApp Configuration (optional — set WHATSAPP_ENABLED=true to activate)
WHATSAPP_ENABLED=false
# Phone Number ID from Meta Business Manager > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Permanent access token from Meta Business Manager > System Users
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# Webhook verification token — any string you choose, must match Meta webhook config
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Meta App Secret from Meta Developers > App Settings > Basic (for webhook signature verification)
WHATSAPP_APP_SECRET=your-app-secret
# Salt for hashing phone numbers before storage (PII protection)
PHONE_HASH_SALT=forwardcheck-ai-v1

# Feedback & GitHub Integration (optional)
GITHUB_TOKEN=ghp_your-fine-grained-pat
GITHUB_REPO_OWNER=chandrameenamohan
GITHUB_REPO_NAME=forward-check-ai
