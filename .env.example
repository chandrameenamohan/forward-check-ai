# ForwardCheck-AI Environment Variables

# Required
ANTHROPIC_API_KEY=your-anthropic-api-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Search APIs (optional — investigations will skip search if not set)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/forwardcheck.db

# WhatsApp Business API (optional — enable for WhatsApp channel)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Feedback & GitHub Integration (optional)
GITHUB_TOKEN=ghp_your-fine-grained-pat
GITHUB_REPO_OWNER=chandrameenamohan
GITHUB_REPO_NAME=forward-check-ai
