{
  "name": "forward-check-ai",
  "version": "1.0.0",
  "description": "Telegram bot that fact-checks forwarded messages using multi-agent AI pipeline with Claude",
  "type": "module",
  "scripts": {
    "start": "node --import tsx/esm src/index.ts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "quality": "bash scripts/quality-gate.sh",
    "quality:full": "bash scripts/quality-full.sh",
    "deploy": "bash scripts/deploy.sh",
    "eval": "npx tsx eval/run-eval.ts --mode mock --skip-groundedness",
    "eval:full": "npx tsx eval/run-eval.ts --mode mock",
    "eval:live": "npx tsx eval/run-eval.ts --mode live"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "grammy": "^1.42.0",
    "jsdom": "^29.1.1",
    "nanoid": "^5.1.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "zod": "^4.4.2"
  }
}
