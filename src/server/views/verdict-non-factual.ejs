<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Not a Factual Claim — ForwardCheck</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Satoshi:wght@400;500;700;900&display=swap" rel="stylesheet">
  <%- include('_design-tokens') %>
  <style>
    :root { --fc-verdict-color: var(--fc-accent-blue); }
    .fc-wrapper { position: relative; z-index: 1; max-width: 780px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    .fc-topbar { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--fc-border); margin-bottom: 2.5rem; font-family: 'DM Mono', monospace; font-size: 0.7rem; color: var(--fc-text-dim); letter-spacing: 0.08em; text-transform: uppercase; }
    .fc-topbar-brand { color: var(--fc-text-muted); font-weight: 500; }
    .fc-hero { text-align: center; padding: 3rem 0 2.5rem; }
    .fc-verdict-badge { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.6rem 1.6rem; border: 2px solid var(--fc-verdict-color); border-radius: 100px; font-family: 'DM Mono', monospace; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fc-verdict-color); background: color-mix(in srgb, var(--fc-verdict-color) 8%, transparent); }
    .fc-verdict-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--fc-verdict-color); box-shadow: 0 0 8px var(--fc-verdict-color); }
    .fc-summary { margin-top: 2rem; font-family: 'Instrument Serif', serif; font-size: 1.35rem; font-style: italic; line-height: 1.55; color: var(--fc-text); max-width: 580px; margin-left: auto; margin-right: auto; }
    .fc-section { margin-top: 2.5rem; padding: 1.5rem; background: var(--fc-surface); border: 1px solid var(--fc-border); border-radius: 8px; }
    .fc-section-title { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fc-text-dim); margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--fc-border); }
    .fc-section p { font-size: 0.88rem; color: var(--fc-text-muted); line-height: 1.65; }
    .fc-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--fc-border); display: flex; flex-wrap: wrap; gap: 1.5rem; font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--fc-text-dim); letter-spacing: 0.06em; }
    .fc-footer-item { display: flex; align-items: center; gap: 0.4rem; }
    .fc-footer-label { text-transform: uppercase; letter-spacing: 0.1em; }
  </style>
</head>
<body>
  <div class="fc-wrapper">

    <div class="fc-topbar">
      <span class="fc-topbar-brand">ForwardCheck</span>
      <span>Investigation #<%= id.slice(0, 8) %></span>
    </div>

    <section class="fc-hero">
      <div class="fc-verdict-badge">
        <span class="fc-verdict-dot"></span>
        <%= category %>
      </div>

      <p class="fc-summary"><%= explanation %></p>
    </section>

    <div class="fc-section">
      <div class="fc-section-title">Original Message</div>
      <p><%= originalMessage %></p>
    </div>

    <footer class="fc-footer">
      <div class="fc-footer-item">
        <span class="fc-footer-label">Status</span>
        <span>No investigation needed</span>
      </div>
      <div class="fc-footer-item">
        <span class="fc-footer-label">ID</span>
        <span><%= id %></span>
      </div>
    </footer>

  </div>
</body>
</html>
