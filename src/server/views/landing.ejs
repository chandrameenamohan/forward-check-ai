<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ForwardCheck-AI — Fact-check any message in 60 seconds</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Satoshi:wght@400;500;700;900&display=swap" rel="stylesheet">
  <%- include('_landing-styles') %>
</head>
<body>
  <div class="fc-landing-wrapper">

    <nav class="fc-topbar">
      <span class="fc-topbar-brand">ForwardCheck</span>
      <a class="fc-topbar-link" href="https://github.com/chandrameenamohan/forward-check-ai" target="_blank" rel="noopener">GitHub</a>
    </nav>

    <main>

      <!-- ─── HERO ─── -->
      <section class="fc-hero">
        <div class="fc-hero-radar">
          <div class="fc-radar-ring fc-radar-ring--1"></div>
          <div class="fc-radar-ring fc-radar-ring--2"></div>
          <div class="fc-radar-ring fc-radar-ring--3"></div>
          <div class="fc-radar-sweep"></div>
        </div>

        <div class="fc-hero-content">
          <div class="fc-hero-eyebrow">
            <span class="fc-hero-eyebrow-dot"></span>
            <span>AI-Powered Fact Checking</span>
          </div>

          <h1 class="fc-hero-headline">
            Lies travel fast.<br>
            <span class="fc-hero-headline-accent">The truth needs backup.</span>
          </h1>

          <p class="fc-hero-sub">
            Forward any suspicious message. Six AI agents investigate it
            and deliver a verdict — in under 60 seconds.
          </p>

          <div class="fc-hero-ctas">
            <a href="https://t.me/ForwardCheckBot" class="fc-cta-primary" target="_blank" rel="noopener">
              Try it on Telegram
              <span class="fc-cta-arrow">→</span>
            </a>
            <a href="/v/demo" class="fc-cta-secondary">
              See a live verdict
              <span class="fc-cta-arrow">→</span>
            </a>
          </div>

          <div class="fc-hero-proof">
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Free to use
            </span>
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              No sign-up needed
            </span>
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Powered by Claude Opus 4.6
            </span>
          </div>
        </div>
      </section>

      <!-- ─── DEMO ANIMATION ─── -->
      <section class="fc-demo" aria-label="Live fact-check demo">
        <div class="fc-demo-card">
          <!-- Forwarded message bubble -->
          <div class="fc-demo-message">
            <div class="fc-demo-message-fwd">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
              Forwarded
            </div>
            <p class="fc-demo-message-text">NASA confirms Mars will be as big as the Moon on October 17th — visible to the naked eye for the first time in 800 years!!</p>
          </div>

          <!-- Pipeline steps -->
          <div class="fc-demo-pipeline">
            <div class="fc-demo-step fc-demo-step--1">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a8 8 0 0 0-8 8c0 3 1.5 5.5 4 7v3h8v-3c2.5-1.5 4-4 4-7a8 8 0 0 0-8-8z"/><line x1="10" y1="22" x2="14" y2="22"/></svg>
              </span>
              <span class="fc-demo-step-label">Classifying claim</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--2">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
              <span class="fc-demo-step-label">Planning investigation</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--3">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
              <span class="fc-demo-step-label">Searching 3 sources</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--4">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2c1.5 0 3 .5 3 2-2 1-3 2.5-3 4 0-1.5-1-3-3-4 0-1.5 1.5-2 3-2z"/><path d="M8 15c-2.7-1-4-3.5-4-6 2 0 4 1 5 3"/><path d="M16 15c2.7-1 4-3.5 4-6-2 0-4 1-5 3"/><path d="M12 22v-7"/><path d="M8 22h8"/></svg>
              </span>
              <span class="fc-demo-step-label">Challenging findings</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--5">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </span>
              <span class="fc-demo-step-label">Rendering verdict</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
          </div>

          <!-- Verdict result -->
          <div class="fc-demo-verdict">
            <div class="fc-demo-verdict-badge">
              <span class="fc-demo-verdict-dot"></span>
              LIKELY FALSE
            </div>
            <span class="fc-demo-verdict-conf">94% confidence</span>
          </div>
        </div>
      </section>

    </main>

  </div>
</body>
</html>
