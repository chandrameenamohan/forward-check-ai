      <p class="fc-footer-line">Built for Cerebral Valley × Anthropic Hackathon — Feb 2026</p>
      <p class="fc-footer-line"><a href="/feedback" class="fc-footer-link">Report a Bug</a></p>
      <p class="fc-footer-line">Powered by Claude Opus 4.6</p>
    </footer>

  </div>

  <script>
    (function() {
      /* Respect prefers-reduced-motion: show everything immediately */
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ─── Pipeline steps (existing behavior) ─── */
      var steps = document.querySelectorAll('.fc-pipeline-step');
      if (reduced || !('IntersectionObserver' in window)) {
        steps.forEach(function(s) { s.classList.add('fc-pipeline-step--visible'); });
      } else {
        var pipeObs = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('fc-pipeline-step--visible');
              pipeObs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });
        steps.forEach(function(s) { pipeObs.observe(s); });
      }

      /* ─── Generic scroll animations for .fc-animate ─── */
      var animEls = document.querySelectorAll('.fc-animate');
      if (reduced || !('IntersectionObserver' in window)) {
        animEls.forEach(function(el) { el.classList.add('fc-animate--visible'); });
        return;
      }
      var animObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('fc-animate--visible');
            animObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      animEls.forEach(function(el) { animObs.observe(el); });
    })();
  </script>
</body>
</html>
