<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ForwardCheck-AI — Fact-check any message in 60 seconds</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Satoshi:wght@400;500;700;900&display=swap" rel="stylesheet">
  <%- include('_landing-styles') %>
</head>
<body>
  <div class="fc-landing-wrapper">

    <nav class="fc-topbar">
      <span class="fc-topbar-brand">ForwardCheck</span>
      <a class="fc-topbar-link" href="https://github.com/chandrameenamohan/forward-check-ai" target="_blank" rel="noopener">GitHub</a>
    </nav>

    <main>

      <!-- ─── HERO ─── -->
      <section class="fc-hero">
        <div class="fc-hero-radar">
          <div class="fc-radar-ring fc-radar-ring--1"></div>
          <div class="fc-radar-ring fc-radar-ring--2"></div>
          <div class="fc-radar-ring fc-radar-ring--3"></div>
          <div class="fc-radar-sweep"></div>
        </div>

        <div class="fc-hero-content">
          <div class="fc-hero-eyebrow">
            <span class="fc-hero-eyebrow-dot"></span>
            <span>AI-Powered Fact Checking</span>
          </div>

          <h1 class="fc-hero-headline">
            Lies travel fast.<br>
            <span class="fc-hero-headline-accent">The truth needs backup.</span>
          </h1>

          <p class="fc-hero-sub">
            Forward any suspicious message. Six AI agents investigate it
            and deliver a verdict — in under 60 seconds.
          </p>

          <div class="fc-hero-ctas">
            <a href="https://t.me/ForwardCheckBot" class="fc-cta-primary" target="_blank" rel="noopener">
              Try it on Telegram
              <span class="fc-cta-arrow">→</span>
            </a>
            <a href="/v/demo" class="fc-cta-secondary">
              See a live verdict
              <span class="fc-cta-arrow">→</span>
            </a>
          </div>

          <div class="fc-hero-proof">
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Free to use
            </span>
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              No sign-up needed
            </span>
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Powered by Claude Opus 4.6
            </span>
          </div>
        </div>
      </section>

      <!-- ─── DEMO ANIMATION ─── -->
      <section class="fc-demo" aria-label="Live fact-check demo">
        <div class="fc-demo-card">
          <!-- Forwarded message bubble -->
          <div class="fc-demo-message">
            <div class="fc-demo-message-fwd">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
              Forwarded
            </div>
            <p class="fc-demo-message-text">NASA confirms Mars will be as big as the Moon on October 17th — visible to the naked eye for the first time in 800 years!!</p>
          </div>

          <!-- Pipeline steps -->
          <div class="fc-demo-pipeline">
            <div class="fc-demo-step fc-demo-step--1">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a8 8 0 0 0-8 8c0 3 1.5 5.5 4 7v3h8v-3c2.5-1.5 4-4 4-7a8 8 0 0 0-8-8z"/><line x1="10" y1="22" x2="14" y2="22"/></svg>
              </span>
              <span class="fc-demo-step-label">Classifying claim</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--2">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
              <span class="fc-demo-step-label">Planning investigation</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--3">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
              <span class="fc-demo-step-label">Searching 3 sources</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--4">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2c1.5 0 3 .5 3 2-2 1-3 2.5-3 4 0-1.5-1-3-3-4 0-1.5 1.5-2 3-2z"/><path d="M8 15c-2.7-1-4-3.5-4-6 2 0 4 1 5 3"/><path d="M16 15c2.7-1 4-3.5 4-6-2 0-4 1-5 3"/><path d="M12 22v-7"/><path d="M8 22h8"/></svg>
              </span>
              <span class="fc-demo-step-label">Challenging findings</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
            <div class="fc-demo-step fc-demo-step--5">
              <span class="fc-demo-step-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </span>
              <span class="fc-demo-step-label">Rendering verdict</span>
              <span class="fc-demo-step-status">
                <span class="fc-demo-spinner"></span>
                <svg class="fc-demo-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            </div>
          </div>

          <!-- Verdict result -->
          <div class="fc-demo-verdict">
            <div class="fc-demo-verdict-badge">
              <span class="fc-demo-verdict-dot"></span>
              LIKELY FALSE
            </div>
            <span class="fc-demo-verdict-conf">94% confidence</span>
          </div>
        </div>
      </section>

      <!-- ─── PIPELINE: HOW IT WORKS ─── -->
      <section class="fc-pipeline" aria-label="How the pipeline works">
        <div class="fc-pipeline-header">
          <span class="fc-pipeline-eyebrow">The Pipeline</span>
          <h2 class="fc-pipeline-title">What Happens When You Hit Forward</h2>
          <p class="fc-pipeline-sub">Your message passes through five specialized AI agents — like a tiny newsroom built just for you.</p>
        </div>

        <div class="fc-pipeline-track">
          <!-- Step 1: Classifier -->
          <div class="fc-pipeline-step" data-step="1">
            <div class="fc-pipeline-node">
              <span class="fc-pipeline-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8c0 3 1.5 5.5 4 7v3h8v-3c2.5-1.5 4-4 4-7a8 8 0 0 0-8-8z"/><line x1="10" y1="22" x2="14" y2="22"/></svg>
              </span>
            </div>
            <div class="fc-pipeline-card">
              <div class="fc-pipeline-card-head">
                <span class="fc-pipeline-name">Classifier</span>
                <span class="fc-pipeline-badge fc-pipeline-badge--haiku">Haiku</span>
              </div>
              <p class="fc-pipeline-desc">Reads your message and spots the claim</p>
            </div>
          </div>

          <!-- Connector -->
          <div class="fc-pipeline-connector" aria-hidden="true">
            <svg class="fc-pipeline-arrow" width="20" height="12" viewBox="0 0 20 12"><path d="M0 6h16M12 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

          <!-- Step 2: Strategist -->
          <div class="fc-pipeline-step" data-step="2">
            <div class="fc-pipeline-node">
              <span class="fc-pipeline-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
            </div>
            <div class="fc-pipeline-card">
              <div class="fc-pipeline-card-head">
                <span class="fc-pipeline-name">Strategist</span>
                <span class="fc-pipeline-badge fc-pipeline-badge--opus">Opus 4.6</span>
              </div>
              <p class="fc-pipeline-desc">Plans the best way to investigate</p>
            </div>
          </div>

          <!-- Connector -->
          <div class="fc-pipeline-connector" aria-hidden="true">
            <svg class="fc-pipeline-arrow" width="20" height="12" viewBox="0 0 20 12"><path d="M0 6h16M12 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

          <!-- Step 3: Investigators -->
          <div class="fc-pipeline-step" data-step="3">
            <div class="fc-pipeline-node">
              <span class="fc-pipeline-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
            </div>
            <div class="fc-pipeline-card">
              <div class="fc-pipeline-card-head">
                <span class="fc-pipeline-name">Investigators <span class="fc-pipeline-multiplier">×3</span></span>
                <span class="fc-pipeline-badge fc-pipeline-badge--sonnet">Sonnet</span>
              </div>
              <p class="fc-pipeline-desc">Dig through sources for evidence</p>
            </div>
          </div>

          <!-- Connector -->
          <div class="fc-pipeline-connector" aria-hidden="true">
            <svg class="fc-pipeline-arrow" width="20" height="12" viewBox="0 0 20 12"><path d="M0 6h16M12 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

          <!-- Step 4: Devil's Advocate -->
          <div class="fc-pipeline-step" data-step="4">
            <div class="fc-pipeline-node">
              <span class="fc-pipeline-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c1.5 0 3 .5 3 2-2 1-3 2.5-3 4 0-1.5-1-3-3-4 0-1.5 1.5-2 3-2z"/><path d="M8 15c-2.7-1-4-3.5-4-6 2 0 4 1 5 3"/><path d="M16 15c2.7-1 4-3.5 4-6-2 0-4 1-5 3"/><path d="M12 22v-7"/><path d="M8 22h8"/></svg>
              </span>
            </div>
            <div class="fc-pipeline-card">
              <div class="fc-pipeline-card-head">
                <span class="fc-pipeline-name">Devil's Advocate</span>
                <span class="fc-pipeline-badge fc-pipeline-badge--opus">Opus 4.6</span>
              </div>
              <p class="fc-pipeline-desc">Tries to tear the findings apart</p>
            </div>
          </div>

          <!-- Connector -->
          <div class="fc-pipeline-connector" aria-hidden="true">
            <svg class="fc-pipeline-arrow" width="20" height="12" viewBox="0 0 20 12"><path d="M0 6h16M12 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

          <!-- Step 5: Judge -->
          <div class="fc-pipeline-step" data-step="5">
            <div class="fc-pipeline-node">
              <span class="fc-pipeline-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 9l10 6 10-6-10-6z"/><path d="M2 15l10 6 10-6"/><path d="M2 9v6"/><path d="M22 9v6"/></svg>
              </span>
            </div>
            <div class="fc-pipeline-card">
              <div class="fc-pipeline-card-head">
                <span class="fc-pipeline-name">Judge</span>
                <span class="fc-pipeline-badge fc-pipeline-badge--opus">Opus 4.6</span>
              </div>
              <p class="fc-pipeline-desc">Weighs everything and delivers the verdict</p>
            </div>
          </div>
        </div>
      </section>

      <script>
        (function() {
          var steps = document.querySelectorAll('.fc-pipeline-step');
          if (!steps.length || !('IntersectionObserver' in window)) {
            steps.forEach(function(s) { s.classList.add('fc-pipeline-step--visible'); });
            return;
          }
          var obs = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('fc-pipeline-step--visible');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.2 });
          steps.forEach(function(s) { obs.observe(s); });
        })();
      </script>

      <!-- ─── FEATURES ─── -->
      <section class="fc-features" aria-label="Key features">
        <div class="fc-features-header">
          <span class="fc-features-eyebrow">What Makes This Different</span>
          <h2 class="fc-features-title">Not Just True or False</h2>
        </div>

        <div class="fc-features-grid">
          <!-- Card 1: Manipulation Detection -->
          <div class="fc-features-card">
            <div class="fc-features-card-accent fc-features-card-accent--red"></div>
            <div class="fc-features-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h3 class="fc-features-card-title">See the Tricks</h3>
            <p class="fc-features-card-body">Most fact-checkers stop at "true" or "false." ForwardCheck shows you the tricks — emotional framing, missing context, cherry-picked data. You don't just learn what's fake. You learn how to spot it yourself.</p>
          </div>

          <!-- Card 2: Visible AI Reasoning -->
          <div class="fc-features-card">
            <div class="fc-features-card-accent fc-features-card-accent--blue"></div>
            <div class="fc-features-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 class="fc-features-card-title">Watch the Debate</h3>
            <p class="fc-features-card-body">A Devil's Advocate tries to tear the verdict apart. If it can't, you know the answer holds up. You see the full argument — not a black box that says "trust me."</p>
          </div>

          <!-- Card 3: Confidence Decomposition -->
          <div class="fc-features-card">
            <div class="fc-features-card-accent fc-features-card-accent--green"></div>
            <div class="fc-features-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="12" width="4" height="9" rx="1"/><rect x="10" y="8" width="4" height="13" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/></svg>
            </div>
            <h3 class="fc-features-card-title">Four Scores, Not One</h3>
            <p class="fc-features-card-body">One number can't capture the truth. So we break confidence into four parts: evidence strength, source quality, claim complexity, and counter-argument resilience. You decide what matters.</p>
          </div>
        </div>
      </section>

      <!-- ─── VERDICT PREVIEW ─── -->
      <section class="fc-verdict-preview" aria-label="Live verdict example">
        <div class="fc-verdict-preview-header">
          <span class="fc-verdict-preview-eyebrow">Proof</span>
          <h2 class="fc-verdict-preview-title">Don't Take Our Word For It</h2>
          <p class="fc-verdict-preview-sub">Here's a real verdict from a viral claim that hit thousands of inboxes.</p>
        </div>

        <div class="fc-verdict-preview-card">
          <!-- Glow accent behind card -->
          <div class="fc-verdict-preview-glow" aria-hidden="true"></div>

          <!-- Original claim quote -->
          <div class="fc-verdict-preview-claim">
            <div class="fc-verdict-preview-claim-label">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
              Forwarded claim
            </div>
            <p class="fc-verdict-preview-claim-text">PM Modi announces Rs 5000 direct transfer to all citizens through new government scheme</p>
          </div>

          <!-- Verdict badge row -->
          <div class="fc-verdict-preview-badge-row">
            <div class="fc-verdict-preview-badge">
              <span class="fc-verdict-preview-badge-dot"></span>
              LIKELY FALSE
            </div>

            <!-- Confidence ring -->
            <div class="fc-verdict-preview-ring">
              <svg width="52" height="52" viewBox="0 0 52 52">
                <circle cx="26" cy="26" r="22" fill="none" stroke="var(--fc-border)" stroke-width="3"/>
                <circle cx="26" cy="26" r="22" fill="none" stroke="var(--fc-accent-red)" stroke-width="3" stroke-linecap="round"
                  stroke-dasharray="127.23" stroke-dashoffset="10.18"
                  transform="rotate(-90 26 26)"/>
              </svg>
              <span class="fc-verdict-preview-ring-label">92%</span>
            </div>
          </div>

          <!-- Summary -->
          <p class="fc-verdict-preview-summary">No official government source confirms this program. The claim traces back to a viral WhatsApp forward with no links, no dates, and no named officials. Three investigators searched government press releases, PIB archives, and fact-checker databases — none found matching announcements.</p>

          <!-- Confidence decomposition -->
          <div class="fc-verdict-preview-scores">
            <div class="fc-verdict-preview-score">
              <div class="fc-verdict-preview-score-head">
                <span class="fc-verdict-preview-score-label">Evidence strength</span>
                <span class="fc-verdict-preview-score-val">18%</span>
              </div>
              <div class="fc-verdict-preview-score-track">
                <div class="fc-verdict-preview-score-fill fc-verdict-preview-score-fill--low" style="width:18%"></div>
              </div>
            </div>
            <div class="fc-verdict-preview-score">
              <div class="fc-verdict-preview-score-head">
                <span class="fc-verdict-preview-score-label">Source quality</span>
                <span class="fc-verdict-preview-score-val">12%</span>
              </div>
              <div class="fc-verdict-preview-score-track">
                <div class="fc-verdict-preview-score-fill fc-verdict-preview-score-fill--low" style="width:12%"></div>
              </div>
            </div>
            <div class="fc-verdict-preview-score">
              <div class="fc-verdict-preview-score-head">
                <span class="fc-verdict-preview-score-label">Claim complexity</span>
                <span class="fc-verdict-preview-score-val">35%</span>
              </div>
              <div class="fc-verdict-preview-score-track">
                <div class="fc-verdict-preview-score-fill fc-verdict-preview-score-fill--mid" style="width:35%"></div>
              </div>
            </div>
            <div class="fc-verdict-preview-score">
              <div class="fc-verdict-preview-score-head">
                <span class="fc-verdict-preview-score-label">Counter-argument resilience</span>
                <span class="fc-verdict-preview-score-val">8%</span>
              </div>
              <div class="fc-verdict-preview-score-track">
                <div class="fc-verdict-preview-score-fill fc-verdict-preview-score-fill--low" style="width:8%"></div>
              </div>
            </div>
          </div>

          <!-- CTA -->
          <a href="/v/demo" class="fc-verdict-preview-cta">
            Read the full analysis
            <span class="fc-verdict-preview-cta-arrow">→</span>
          </a>
        </div>
      </section>

    </main>

  </div>
</body>
</html>
