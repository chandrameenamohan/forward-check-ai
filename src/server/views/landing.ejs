<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ForwardCheck-AI — Fact-check any message in 60 seconds</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Satoshi:wght@400;500;700;900&display=swap" rel="stylesheet">
  <%- include('_landing-styles') %>
</head>
<body>
  <div class="fc-landing-wrapper">

    <nav class="fc-topbar">
      <span class="fc-topbar-brand">ForwardCheck</span>
      <a class="fc-topbar-link" href="https://github.com/chandrameenamohan/forward-check-ai" target="_blank" rel="noopener">GitHub</a>
    </nav>

    <main>

      <!-- ─── HERO ─── -->
      <section class="fc-hero">
        <div class="fc-hero-radar">
          <div class="fc-radar-ring fc-radar-ring--1"></div>
          <div class="fc-radar-ring fc-radar-ring--2"></div>
          <div class="fc-radar-ring fc-radar-ring--3"></div>
          <div class="fc-radar-sweep"></div>
        </div>

        <div class="fc-hero-content">
          <div class="fc-hero-eyebrow">
            <span class="fc-hero-eyebrow-dot"></span>
            <span>AI-Powered Fact Checking</span>
          </div>

          <h1 class="fc-hero-headline">
            Lies travel fast.<br>
            <span class="fc-hero-headline-accent">The truth needs backup.</span>
          </h1>

          <p class="fc-hero-sub">
            Forward any suspicious message. Six AI agents investigate it
            and deliver a verdict — in under 60 seconds.
          </p>

          <div class="fc-hero-ctas">
            <a href="https://t.me/ForwardCheckBot" class="fc-cta-primary" target="_blank" rel="noopener">
              Try it on Telegram
              <span class="fc-cta-arrow">→</span>
            </a>
            <a href="/v/demo" class="fc-cta-secondary">
              See a live verdict
              <span class="fc-cta-arrow">→</span>
            </a>
          </div>

          <div class="fc-hero-proof">
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Free to use
            </span>
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              No sign-up needed
            </span>
            <span class="fc-hero-proof-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fc-accent-green)" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Powered by Claude Opus 4.6
            </span>
          </div>
        </div>
      </section>

    </main>

  </div>
</body>
</html>
