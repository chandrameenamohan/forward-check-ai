<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ForwardCheck-AI — See the manipulation tactics hiding in any message</title>
  <meta name="description" content="Forward any suspicious message to ForwardCheck-AI. Six AI agents show you the manipulation hiding inside — the spin, the missing context, the tricks.">
  <link rel="canonical" href="https://forwardcheck.ai/">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="ForwardCheck-AI — See the manipulation tactics hiding in any message">
  <meta property="og:description" content="Forward any suspicious message. Six AI agents don't just say true or false — they show you the manipulation hiding inside.">
  <meta property="og:url" content="https://forwardcheck.ai/">
