<%- include('_design-tokens') %>
<style>
    .fc-live-wrapper {
      position: relative;
      z-index: 1;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.25rem 3rem;
      min-height: 100vh;
    }

    /* ─── Topbar ─── */
    .fc-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--fc-border);
      margin-bottom: 2rem;
    }
    .fc-topbar-brand {
      font-family: 'DM Mono', monospace;
      font-weight: 500;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      color: var(--fc-accent-green);
    }
    .fc-topbar-id {
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-text-dim);
    }

    /* ─── Status header ─── */
    .fc-live-status {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .fc-live-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--fc-accent-green);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .fc-live-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--fc-accent-green);
      animation: fc-pulse 2s ease-in-out infinite;
    }
    .fc-live-headline {
      font-family: 'Instrument Serif', serif;
      font-size: 2rem;
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 0.5rem;
    }
    .fc-live-subtitle {
      font-size: 0.95rem;
      color: var(--fc-text-muted);
      max-width: 480px;
      margin: 0 auto;
    }

    /* ─── Original message card ─── */
    .fc-live-message {
      background: var(--fc-surface);
      border: 1px solid var(--fc-border);
      border-left: 3px solid var(--fc-accent-blue);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2.5rem;
      backdrop-filter: blur(12px);
    }
    .fc-live-message-label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      color: var(--fc-accent-blue);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.6rem;
    }
    .fc-live-message-text {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--fc-text);
    }

    /* ─── Progress header ─── */
    .fc-progress-header {
      background: var(--fc-surface);
      border: 1px solid var(--fc-border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem 1rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(16px);
    }
    .fc-progress-header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .fc-progress-header-title {
      font-family: 'Satoshi', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--fc-text);
    }
    .fc-elapsed {
      font-family: 'DM Mono', monospace;
      font-size: 0.85rem;
      font-weight: 400;
      color: var(--fc-text-muted);
      letter-spacing: 0.03em;
      min-width: 3.2em;
      text-align: right;
    }

    /* ─── Segmented progress bar ─── */
    .fc-progress-bar {
      display: flex;
      gap: 3px;
      margin-bottom: 0.5rem;
    }
    .fc-progress-segment {
      flex: 1;
      height: 6px;
      background: var(--fc-surface-raised);
      border-radius: 3px;
      overflow: hidden;
      position: relative;
    }
    .fc-progress-segment-fill {
      position: absolute;
      inset: 0;
      border-radius: 3px;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s ease;
    }
    .fc-progress-segment--active .fc-progress-segment-fill {
      background: var(--fc-accent-amber);
      transform: scaleX(1);
      animation: fc-segment-pulse 1.5s ease-in-out infinite;
    }
    .fc-progress-segment--complete .fc-progress-segment-fill {
      background: var(--fc-accent-green);
      transform: scaleX(1);
      animation: none;
    }

    /* ─── Progress labels ─── */
    .fc-progress-labels {
      display: flex;
      gap: 3px;
      margin-bottom: 0.75rem;
    }
    .fc-progress-label {
      flex: 1;
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      color: var(--fc-text-dim);
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* ─── Cost tracker ─── */
    .fc-cost-tracker {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      color: var(--fc-text-dim);
      letter-spacing: 0.03em;
    }
    .fc-cost-tracker svg {
      opacity: 0.5;
    }

    /* ─── Pipeline visualization area ─── */
    .fc-live-pipeline {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    /* ─── Connecting spinner ─── */
    .fc-connecting-spinner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 3rem 1rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--fc-text-dim);
      text-align: center;
    }
    .fc-connecting-spinner-ring {
      width: 32px;
      height: 32px;
      border: 2px solid var(--fc-border);
      border-top-color: var(--fc-accent-green);
      border-radius: 50%;
      animation: fc-spin 0.8s linear infinite;
    }

    /* ─── Agent cards container ─── */
    .fc-agent-cards {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* ─── Pipeline status messages ─── */
    .fc-pipeline-status {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      text-align: center;
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid var(--fc-border);
    }
    .fc-pipeline-status--success {
      color: var(--fc-accent-green);
      border-color: var(--fc-accent-green);
      background: rgba(34, 197, 94, 0.06);
    }
    .fc-pipeline-status--error {
      color: var(--fc-accent-red);
      border-color: var(--fc-accent-red);
      background: rgba(239, 68, 68, 0.06);
    }
    .fc-pipeline-status--warning {
      color: var(--fc-accent-amber);
      border-color: var(--fc-accent-amber);
      background: rgba(234, 179, 8, 0.06);
    }
    .fc-pipeline-status--info {
      color: var(--fc-text-muted);
    }

    /* ─── Agent cards ─── */
    .fc-agent-card {
      background: var(--fc-surface);
      border: 1px solid var(--fc-border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      backdrop-filter: blur(12px);
      transition: border-color 0.5s ease, opacity 0.5s ease, box-shadow 0.5s ease;
    }
    .fc-agent-card-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .fc-agent-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--fc-surface-raised);
      transition: background 0.4s ease, box-shadow 0.4s ease;
      flex-shrink: 0;
    }
    .fc-agent-card-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex: 1;
    }
    .fc-agent-name {
      font-family: 'Satoshi', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .fc-model-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border: 1px solid;
    }
    .fc-model-badge--haiku {
      color: var(--fc-accent-gray);
      border-color: var(--fc-accent-gray);
      background: rgba(107, 114, 128, 0.08);
    }
    .fc-model-badge--sonnet {
      color: var(--fc-accent-blue);
      border-color: var(--fc-accent-blue);
      background: rgba(59, 130, 246, 0.08);
    }
    .fc-model-badge--opus {
      color: var(--fc-accent-green);
      border-color: var(--fc-accent-green);
      background: rgba(34, 197, 94, 0.08);
    }
    .fc-agent-check {
      display: none;
      align-items: center;
      justify-content: center;
      color: var(--fc-accent-green);
    }
    .fc-agent-status {
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-text-dim);
      margin-top: 0.6rem;
      letter-spacing: 0.02em;
      min-height: 1.2em;
    }
    .fc-agent-result {
      margin-top: 0.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      align-items: center;
    }
    .fc-agent-result-tag {
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      background: rgba(34, 197, 94, 0.1);
      color: var(--fc-accent-green);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .fc-agent-result-claim {
      font-size: 0.8rem;
      color: var(--fc-text-muted);
      font-style: italic;
    }
    .fc-agent-result-criteria {
      font-size: 0.8rem;
      color: var(--fc-text-muted);
      line-height: 1.5;
    }

    /* ─── Agent card states ─── */
    .fc-agent--idle {
      opacity: 0.45;
      border-color: var(--fc-border);
    }
    .fc-agent--active {
      opacity: 1;
      border-color: var(--fc-accent-amber);
      box-shadow: 0 0 16px rgba(234, 179, 8, 0.1);
      animation: fc-card-pulse 2s ease-in-out infinite;
    }
    .fc-agent--active .fc-agent-icon {
      background: rgba(234, 179, 8, 0.12);
      box-shadow: 0 0 8px rgba(234, 179, 8, 0.15);
    }
    .fc-agent--active .fc-agent-status {
      color: var(--fc-accent-amber);
    }
    .fc-agent--complete {
      opacity: 1;
      border-color: var(--fc-accent-green);
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.06);
    }
    .fc-agent--complete .fc-agent-icon {
      background: rgba(34, 197, 94, 0.12);
    }
    .fc-agent--complete .fc-agent-status {
      color: var(--fc-accent-green);
    }
    .fc-agent--failed {
      opacity: 1;
      border-color: var(--fc-accent-red);
    }
    .fc-agent--failed .fc-agent-status {
      color: var(--fc-accent-red);
    }

    /* ─── Opus badge glow on complete ─── */
    .fc-agent--complete .fc-model-badge--opus {
      box-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
    }

    /* ─── Thinking excerpt ─── */
    .fc-agent-thinking {
      margin-top: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--fc-surface-raised);
      border-radius: 6px;
      border-left: 2px solid var(--fc-accent-purple);
    }
    .fc-agent-thinking-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      color: var(--fc-accent-purple);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: block;
      margin-bottom: 0.4rem;
    }
    .fc-agent-thinking-text {
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      color: var(--fc-text-dim);
      line-height: 1.5;
      max-height: 4.5em;
      overflow: hidden;
    }

    /* ─── Investigator row (3-up horizontal) ─── */
    .fc-investigator-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }
    .fc-investigator-row .fc-agent-card {
      padding: 1rem 1rem;
    }
    .fc-investigator-row .fc-agent-card-header {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .fc-investigator-row .fc-agent-name {
      font-size: 0.78rem;
    }
    .fc-investigator-search {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      color: var(--fc-text-dim);
      margin-top: 0.4rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .fc-investigator-confidence {
      margin-top: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .fc-investigator-confidence-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      background: rgba(34, 197, 94, 0.1);
      color: var(--fc-accent-green);
    }
    .fc-investigator-summary {
      font-size: 0.7rem;
      color: var(--fc-text-muted);
      line-height: 1.4;
      max-height: 2.8em;
      overflow: hidden;
    }

    /* ─── DA card ─── */
    .fc-agent-card--da {
      position: relative;
    }
    .fc-agent-icon--da {
      color: var(--fc-accent-red);
    }
    .fc-agent-card--da.fc-agent--active {
      border-color: var(--fc-accent-red);
      box-shadow: 0 0 20px rgba(239, 68, 68, 0.15);
      animation: fc-da-pulse 2s ease-in-out infinite;
    }
    .fc-agent-card--da.fc-agent--active .fc-agent-icon {
      background: rgba(239, 68, 68, 0.12);
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.2);
    }
    .fc-agent-card--da.fc-agent--active .fc-agent-status {
      color: var(--fc-accent-red);
    }

    /* ─── DA deep reasoning badge ─── */
    .fc-da-deep-reasoning {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.55rem;
      padding: 0.12rem 0.5rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--fc-accent-purple);
      border: 1px solid var(--fc-accent-purple);
      background: rgba(168, 85, 247, 0.08);
    }
    .fc-da-deep-reasoning svg {
      color: var(--fc-accent-purple);
    }

    /* ─── DA outcome badge ─── */
    .fc-da-outcome {
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .fc-da-outcome-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      padding: 0.15rem 0.6rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .fc-da-outcome-badge--defeated {
      color: var(--fc-accent-green);
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
    }
    .fc-da-outcome-badge--held {
      color: var(--fc-accent-red);
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
    }

    /* ─── DA thinking excerpt ─── */
    .fc-da-thinking {
      margin-top: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--fc-surface-raised);
      border-radius: 6px;
      border-left: 2px solid var(--fc-accent-red);
    }

    /* ─── DA entrance animation ─── */
    @keyframes fc-da-entrance {
      0% { opacity: 0; transform: translateX(30px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes fc-da-pulse {
      0%, 100% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.15); }
      50% { box-shadow: 0 0 30px rgba(239, 68, 68, 0.25); }
    }
    .fc-agent-card--da.fc-da-entering {
      animation: fc-da-entrance 0.6s ease-out;
    }

    /* ─── Disagreement alert ─── */
    .fc-disagreement-alert {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.75rem 1rem;
      background: rgba(234, 179, 8, 0.08);
      border: 1px solid var(--fc-accent-amber);
      border-radius: 8px;
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-accent-amber);
      animation: fc-disagreement-flash 0.6s ease;
    }
    @keyframes fc-disagreement-flash {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    /* ─── Connector line ─── */
    .fc-connector-line {
      width: 1px;
      height: 20px;
      background: linear-gradient(to bottom, var(--fc-accent-green), var(--fc-border));
      margin: 0 auto;
      opacity: 0.4;
    }

    /* ─── Animations ─── */
    @keyframes fc-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    @keyframes fc-spin {
      to { transform: rotate(360deg); }
    }
    @keyframes fc-segment-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    @keyframes fc-card-pulse {
      0%, 100% { box-shadow: 0 0 16px rgba(234, 179, 8, 0.1); }
      50% { box-shadow: 0 0 24px rgba(234, 179, 8, 0.2); }
    }

    /* ─── Responsive ─── */
    @media (max-width: 768px) {
      .fc-live-headline {
        font-size: 1.5rem;
      }
      .fc-live-wrapper {
        padding: 0 1rem 2rem;
      }
      .fc-investigator-row {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 375px) {
      .fc-live-headline {
        font-size: 1.3rem;
      }
      .fc-progress-labels {
        display: none;
      }
      .fc-progress-header {
        padding: 1rem;
      }
    }

    /* ─── Reduced motion ─── */
    @media (prefers-reduced-motion: reduce) {
      .fc-live-status-dot,
      .fc-connecting-spinner-ring,
      .fc-progress-segment--active .fc-progress-segment-fill,
      .fc-agent--active,
      .fc-disagreement-alert,
      .fc-agent-card--da.fc-da-entering,
      .fc-agent-card--da.fc-agent--active {
        animation: none;
      }
      .fc-progress-segment-fill,
      .fc-agent-card,
      .fc-agent-icon {
        transition: none;
      }
    }
</style>
