<%- include('_design-tokens') %>
<style>
    .fc-live-wrapper {
      position: relative;
      z-index: 1;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.25rem 3rem;
      min-height: 100vh;
    }

    /* ─── Topbar ─── */
    .fc-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--fc-border);
      margin-bottom: 2rem;
    }
    .fc-topbar-brand {
      font-family: 'DM Mono', monospace;
      font-weight: 500;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      color: var(--fc-accent-green);
    }
    .fc-topbar-id {
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-text-dim);
    }

    /* ─── Status header ─── */
    .fc-live-status {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .fc-live-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--fc-accent-green);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .fc-live-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--fc-accent-green);
      animation: fc-pulse 2s ease-in-out infinite;
    }
    .fc-live-headline {
      font-family: 'Instrument Serif', serif;
      font-size: 2rem;
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 0.5rem;
    }
    .fc-live-subtitle {
      font-size: 0.95rem;
      color: var(--fc-text-muted);
      max-width: 480px;
      margin: 0 auto;
    }

    /* ─── Original message card ─── */
    .fc-live-message {
      background: var(--fc-surface);
      border: 1px solid var(--fc-border);
      border-left: 3px solid var(--fc-accent-blue);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2.5rem;
      backdrop-filter: blur(12px);
    }
    .fc-live-message-label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      color: var(--fc-accent-blue);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.6rem;
    }
    .fc-live-message-text {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--fc-text);
    }

    /* ─── Pipeline visualization area ─── */
    .fc-live-pipeline {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    /* ─── Connecting spinner ─── */
    .fc-connecting-spinner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 3rem 1rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--fc-text-dim);
      text-align: center;
    }
    .fc-connecting-spinner-ring {
      width: 32px;
      height: 32px;
      border: 2px solid var(--fc-border);
      border-top-color: var(--fc-accent-green);
      border-radius: 50%;
      animation: fc-spin 0.8s linear infinite;
    }

    /* ─── Agent cards container ─── */
    .fc-agent-cards {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* ─── Pipeline status messages ─── */
    .fc-pipeline-status {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      text-align: center;
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid var(--fc-border);
    }
    .fc-pipeline-status--success {
      color: var(--fc-accent-green);
      border-color: var(--fc-accent-green);
      background: rgba(34, 197, 94, 0.06);
    }
    .fc-pipeline-status--error {
      color: var(--fc-accent-red);
      border-color: var(--fc-accent-red);
      background: rgba(239, 68, 68, 0.06);
    }
    .fc-pipeline-status--warning {
      color: var(--fc-accent-amber);
      border-color: var(--fc-accent-amber);
      background: rgba(234, 179, 8, 0.06);
    }
    .fc-pipeline-status--info {
      color: var(--fc-text-muted);
    }

    /* ─── Animations ─── */
    @keyframes fc-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    @keyframes fc-spin {
      to { transform: rotate(360deg); }
    }

    /* ─── Responsive ─── */
    @media (max-width: 768px) {
      .fc-live-headline {
        font-size: 1.5rem;
      }
      .fc-live-wrapper {
        padding: 0 1rem 2rem;
      }
    }

    @media (max-width: 375px) {
      .fc-live-headline {
        font-size: 1.3rem;
      }
    }

    /* ─── Reduced motion ─── */
    @media (prefers-reduced-motion: reduce) {
      .fc-live-status-dot,
      .fc-connecting-spinner-ring {
        animation: none;
      }
    }
</style>
