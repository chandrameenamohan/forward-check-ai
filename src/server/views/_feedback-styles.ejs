<%- include('_design-tokens') %>
<style>
    /* ═══ FEEDBACK PAGE LAYOUT ═══ */

    .fc-feedback-wrapper {
      position: relative;
      z-index: 1;
      max-width: 640px;
      margin: 0 auto;
      padding: 0 1.25rem 3rem;
      min-height: 100vh;
    }

    /* ─── Topbar ─── */
    .fc-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--fc-border);
      margin-bottom: 2.5rem;
    }
    .fc-topbar-brand {
      font-family: 'DM Mono', monospace;
      font-weight: 500;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      color: var(--fc-accent-green);
      text-decoration: none;
    }
    .fc-topbar-link {
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-text-dim);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      transition: color 0.2s ease;
    }
    .fc-topbar-link:hover {
      color: var(--fc-accent-green);
    }
    .fc-topbar-brand:focus-visible,
    .fc-topbar-link:focus-visible {
      outline: 2px solid var(--fc-accent-green);
      outline-offset: 2px;
      border-radius: 4px;
    }

    /* ─── Header ─── */
    .fc-feedback-header {
      text-align: center;
      margin-bottom: 2rem;
      animation: fc-feedback-entrance 0.6s ease-out both;
    }
    .fc-feedback-headline {
      font-family: 'Satoshi', sans-serif;
      font-weight: 700;
      font-size: 1.8rem;
      line-height: 1.2;
      color: var(--fc-text);
      margin-bottom: 0.6rem;
    }
    .fc-feedback-subtitle {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--fc-text-muted);
      line-height: 1.5;
    }

    @keyframes fc-feedback-entrance {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ─── Card ─── */
    .fc-feedback-card {
      background: rgba(18, 18, 26, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--fc-border);
      border-radius: 12px;
      padding: 1.75rem;
      animation: fc-feedback-entrance 0.6s ease-out 0.12s both;
    }

    /* ─── Type Selector (segmented control) ─── */
    .fc-feedback-type-label {
      display: block;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--fc-text-dim);
      margin-bottom: 0.6rem;
    }
    .fc-feedback-type-group {
      display: flex;
      gap: 0;
      background: var(--fc-bg);
      border: 1px solid var(--fc-border);
      border-radius: 8px;
      padding: 3px;
      margin-bottom: 1.5rem;
    }
    .fc-feedback-type-group input[type="radio"] {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .fc-feedback-type-option {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.55rem 0.5rem;
      border-radius: 6px;
      cursor: pointer;
      font-family: 'Satoshi', sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--fc-text-muted);
      transition: all 0.25s ease;
      user-select: none;
    }
    .fc-feedback-type-option:hover {
      color: var(--fc-text);
    }
    .fc-feedback-type-emoji {
      font-size: 1rem;
      line-height: 1;
    }

    /* Selected states */
    input[value="bug"]:checked + .fc-feedback-type-option {
      background: rgba(239, 68, 68, 0.12);
      color: var(--fc-accent-red);
      box-shadow: 0 0 12px rgba(239, 68, 68, 0.1);
    }
    input[value="feedback"]:checked + .fc-feedback-type-option {
      background: rgba(59, 130, 246, 0.12);
      color: var(--fc-accent-blue);
      box-shadow: 0 0 12px rgba(59, 130, 246, 0.1);
    }
    input[value="feature"]:checked + .fc-feedback-type-option {
      background: rgba(168, 85, 247, 0.12);
      color: var(--fc-accent-purple);
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.1);
    }

    /* ─── Inputs ─── */
    .fc-feedback-field {
      margin-bottom: 1.25rem;
    }
    .fc-feedback-field-label {
      display: block;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--fc-text-dim);
      margin-bottom: 0.5rem;
    }
    .fc-feedback-input {
      width: 100%;
      padding: 0.7rem 0.9rem;
      background: var(--fc-bg);
      border: 1px solid var(--fc-border);
      border-radius: 8px;
      color: var(--fc-text);
      font-family: 'Satoshi', sans-serif;
      font-size: 0.9rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .fc-feedback-input::placeholder {
      color: var(--fc-text-dim);
    }
    .fc-feedback-input:focus {
      outline: none;
      border-color: var(--fc-accent-green);
      box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.15);
    }
    .fc-feedback-textarea {
      resize: vertical;
      min-height: 120px;
      max-height: 400px;
      line-height: 1.6;
    }
    .fc-feedback-counter {
      display: block;
      text-align: right;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      color: var(--fc-text-dim);
      margin-top: 0.35rem;
      transition: color 0.2s ease;
    }
    .fc-feedback-counter--warn {
      color: var(--fc-accent-amber);
    }
    .fc-feedback-counter--over {
      color: var(--fc-accent-red);
    }

    /* ─── Submit Button ─── */
    .fc-feedback-submit {
      width: 100%;
      padding: 0.75rem 1.5rem;
      background: var(--fc-accent-green);
      color: var(--fc-bg);
      border: none;
      border-radius: 8px;
      font-family: 'Satoshi', sans-serif;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }
    .fc-feedback-submit:hover:not(:disabled) {
      opacity: 0.9;
      transform: translateY(-1px);
    }
    .fc-feedback-submit:active:not(:disabled) {
      transform: translateY(0);
    }
    .fc-feedback-submit:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .fc-feedback-submit:focus-visible {
      outline: 2px solid var(--fc-accent-green);
      outline-offset: 2px;
    }

    /* Spinner */
    @keyframes fc-feedback-spin {
      to { transform: rotate(360deg); }
    }
    .fc-feedback-spinner {
      display: none;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(10, 10, 15, 0.3);
      border-top-color: var(--fc-bg);
      border-radius: 50%;
      animation: fc-feedback-spin 0.6s linear infinite;
    }
    .fc-feedback-submit--loading .fc-feedback-spinner {
      display: inline-block;
    }
    .fc-feedback-submit--loading .fc-feedback-submit-text {
      display: none;
    }

    /* ─── Success State ─── */
    .fc-feedback-success {
      display: none;
      text-align: center;
      padding: 2rem 1.5rem;
      animation: fc-feedback-entrance 0.5s ease-out both;
    }
    .fc-feedback-success-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(34, 197, 94, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
    }
    .fc-feedback-success-icon svg {
      color: var(--fc-accent-green);
    }
    .fc-feedback-success-title {
      font-family: 'Satoshi', sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--fc-text);
      margin-bottom: 0.4rem;
    }
    .fc-feedback-success-body {
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      color: var(--fc-text-muted);
      line-height: 1.6;
      margin-bottom: 1rem;
    }
    .fc-feedback-issue-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-accent-green);
      text-decoration: none;
      padding: 0.5rem 1rem;
      border: 1px solid rgba(34, 197, 94, 0.3);
      border-radius: 6px;
      transition: background 0.2s ease, border-color 0.2s ease;
      margin-bottom: 1rem;
    }
    .fc-feedback-issue-link:hover {
      background: rgba(34, 197, 94, 0.08);
      border-color: var(--fc-accent-green);
    }
    .fc-feedback-reset {
      display: inline-block;
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      color: var(--fc-text-dim);
      text-decoration: none;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0.4rem 0;
      transition: color 0.2s ease;
    }
    .fc-feedback-reset:hover {
      color: var(--fc-text);
    }

    /* ─── Error State ─── */
    .fc-feedback-error {
      display: none;
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      color: var(--fc-accent-red);
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: 8px;
      padding: 0.7rem 1rem;
      margin-top: 1rem;
    }

    /* ─── Responsive: Desktop (769px+) ─── */
    @media (min-width: 769px) {
      .fc-feedback-headline {
        font-size: 2.2rem;
      }
      .fc-feedback-card {
        padding: 2rem;
      }
      .fc-feedback-submit {
        width: auto;
        min-width: 200px;
        margin-left: auto;
        display: flex;
      }
    }

    /* ─── Responsive: Tablet (≤768px) ─── */
    @media (max-width: 768px) {
      .fc-feedback-wrapper {
        padding: 0 1rem 2rem;
      }
      .fc-feedback-headline {
        font-size: 1.5rem;
      }
      .fc-feedback-type-option {
        font-size: 0.72rem;
        padding: 0.5rem 0.3rem;
      }
      .fc-feedback-type-emoji {
        font-size: 0.9rem;
      }
    }

    /* ─── Responsive: Mobile (≤375px) ─── */
    @media (max-width: 375px) {
      .fc-feedback-wrapper {
        padding: 0 0.75rem 1.5rem;
      }
      .fc-feedback-headline {
        font-size: 1.3rem;
      }
      .fc-feedback-subtitle {
        font-size: 0.72rem;
      }
      .fc-feedback-card {
        padding: 1.25rem;
        border-radius: 10px;
      }
      .fc-feedback-type-option {
        font-size: 0.68rem;
        padding: 0.45rem 0.2rem;
        gap: 0.25rem;
      }
      .fc-feedback-input {
        font-size: 0.85rem;
        padding: 0.6rem 0.75rem;
      }
      .fc-feedback-submit {
        font-size: 0.82rem;
        padding: 0.65rem 1rem;
        min-height: 44px;
      }
    }

    /* ─── Reduced Motion ─── */
    @media (prefers-reduced-motion: reduce) {
      .fc-feedback-header,
      .fc-feedback-card,
      .fc-feedback-success {
        animation: none;
        opacity: 1;
        transform: none;
      }
      .fc-feedback-spinner {
        animation: none;
      }
      .fc-feedback-type-option,
      .fc-feedback-input,
      .fc-feedback-submit,
      .fc-feedback-counter,
      .fc-topbar-link {
        transition: none;
      }
    }
  </style>
