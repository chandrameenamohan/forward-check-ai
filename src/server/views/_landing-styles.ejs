<%- include('_design-tokens') %>
  <style>
    .fc-landing-wrapper {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }

    /* ─── TOPBAR ─── */
    .fc-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--fc-border);
      margin-bottom: 2.5rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      color: var(--fc-text-dim);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .fc-topbar-brand {
      color: var(--fc-text-muted);
      font-weight: 500;
      text-decoration: none;
    }

    .fc-topbar-link {
      color: var(--fc-text-dim);
      text-decoration: none;
      transition: color 0.2s;
    }

    .fc-topbar-link:hover {
      color: var(--fc-text-muted);
    }

    /* ─── HERO ─── */
    .fc-hero {
      position: relative;
      text-align: center;
      padding: 6rem 0 5rem;
      overflow: hidden;
    }

    /* ─── RADAR RINGS ─── */
    .fc-hero-radar {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 700px;
      height: 700px;
      pointer-events: none;
    }

    .fc-radar-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1px solid var(--fc-accent-green);
      opacity: 0;
      animation: radar-pulse 4s ease-out infinite;
    }

    .fc-radar-ring--1 {
      inset: 30%;
      animation-delay: 0s;
    }

    .fc-radar-ring--2 {
      inset: 15%;
      animation-delay: 1.2s;
    }

    .fc-radar-ring--3 {
      inset: 0;
      animation-delay: 2.4s;
    }

    @keyframes radar-pulse {
      0% { opacity: 0.25; transform: scale(0.95); }
      50% { opacity: 0.08; }
      100% { opacity: 0; transform: scale(1.05); }
    }

    .fc-radar-sweep {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 50%;
      height: 2px;
      transform-origin: left center;
      background: linear-gradient(90deg, var(--fc-accent-green), transparent);
      opacity: 0.2;
      animation: radar-spin 6s linear infinite;
    }

    @keyframes radar-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* ─── HERO CONTENT ─── */
    .fc-hero-content {
      position: relative;
      z-index: 2;
    }

    .fc-hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--fc-accent-green);
      margin-bottom: 1.5rem;
      padding: 0.35rem 1rem;
      background: rgba(34, 197, 94, 0.06);
      border: 1px solid rgba(34, 197, 94, 0.15);
      border-radius: 100px;
      animation: hero-fade-down 0.8s ease-out both;
    }

    .fc-hero-eyebrow-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--fc-accent-green);
      box-shadow: 0 0 8px var(--fc-accent-green);
      animation: dot-blink 2.5s ease-in-out infinite;
    }

    @keyframes dot-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .fc-hero-headline {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(2.4rem, 6vw, 4.2rem);
      font-weight: 400;
      line-height: 1.15;
      color: var(--fc-text);
      margin-bottom: 1.5rem;
      animation: hero-fade-up 0.9s ease-out 0.15s both;
    }

    .fc-hero-headline-accent {
      background: linear-gradient(135deg, var(--fc-accent-green), var(--fc-accent-blue));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .fc-hero-sub {
      font-family: 'Satoshi', sans-serif;
      font-size: clamp(1rem, 2.2vw, 1.2rem);
      color: var(--fc-text-muted);
      line-height: 1.7;
      max-width: 560px;
      margin: 0 auto 2.5rem;
      animation: hero-fade-up 0.9s ease-out 0.3s both;
    }

    /* ─── CTAs ─── */
    .fc-hero-ctas {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 2.5rem;
      animation: hero-fade-up 0.9s ease-out 0.45s both;
    }

    .fc-cta-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.8rem;
      background: var(--fc-accent-green);
      color: #0a0a0f;
      font-family: 'Satoshi', sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      text-decoration: none;
      border-radius: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 20px rgba(34, 197, 94, 0.25), 0 0 60px rgba(34, 197, 94, 0.08);
    }

    .fc-cta-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(34, 197, 94, 0.4), 0 0 80px rgba(34, 197, 94, 0.12);
      color: #0a0a0f;
    }

    .fc-cta-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.8rem 1.4rem;
      color: var(--fc-text-muted);
      font-family: 'Satoshi', sans-serif;
      font-size: 0.92rem;
      font-weight: 500;
      text-decoration: none;
      border: 1px solid var(--fc-border);
      border-radius: 8px;
      transition: color 0.2s, border-color 0.2s;
    }

    .fc-cta-secondary:hover {
      color: var(--fc-text);
      border-color: var(--fc-text-dim);
    }

    .fc-cta-arrow {
      transition: transform 0.2s;
    }

    .fc-cta-primary:hover .fc-cta-arrow,
    .fc-cta-secondary:hover .fc-cta-arrow {
      transform: translateX(3px);
    }

    /* ─── PROOF BAR ─── */
    .fc-hero-proof {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.2rem;
      animation: hero-fade-up 0.9s ease-out 0.6s both;
    }

    .fc-hero-proof-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.06em;
      color: var(--fc-text-dim);
    }

    /* ─── HERO ANIMATIONS ─── */
    @keyframes hero-fade-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes hero-fade-down {
      from { opacity: 0; transform: translateY(-12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ─── DEMO CARD ─── */
    .fc-demo {
      padding: 0 0 3rem;
      display: flex;
      justify-content: center;
    }

    .fc-demo-card {
      width: 100%;
      max-width: 480px;
      background: rgba(18, 18, 26, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--fc-border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.03),
        0 8px 40px rgba(0, 0, 0, 0.4),
        0 0 80px rgba(34, 197, 94, 0.03);
    }

    /* ─── FORWARDED MESSAGE BUBBLE ─── */
    .fc-demo-message {
      background: var(--fc-surface-raised);
      border-radius: 12px;
      border-left: 3px solid var(--fc-accent-blue);
      padding: 1rem 1.1rem;
      margin-bottom: 1.25rem;
      animation: demo-msg-in 12s ease-out infinite;
    }

    .fc-demo-message-fwd {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fc-accent-blue);
      margin-bottom: 0.5rem;
    }

    .fc-demo-message-text {
      font-family: 'Satoshi', sans-serif;
      font-size: 0.88rem;
      line-height: 1.55;
      color: var(--fc-text);
    }

    @keyframes demo-msg-in {
      0% { opacity: 0; transform: translateY(8px); }
      4% { opacity: 1; transform: translateY(0); }
      85% { opacity: 1; }
      92% { opacity: 0; }
      100% { opacity: 0; }
    }

    /* ─── PIPELINE STEPS ─── */
    .fc-demo-pipeline {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      margin-bottom: 1.25rem;
    }

    .fc-demo-step {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.6rem;
      border-radius: 8px;
      opacity: 0;
      animation: demo-step-lifecycle 12s ease-out infinite;
    }

    .fc-demo-step-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.04);
      color: var(--fc-text-dim);
      flex-shrink: 0;
    }

    .fc-demo-step-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--fc-text-muted);
      flex: 1;
    }

    .fc-demo-step-status {
      display: flex;
      align-items: center;
      width: 16px;
      height: 16px;
      position: relative;
      flex-shrink: 0;
    }

    /* Spinner (visible during loading phase of step) */
    .fc-demo-spinner {
      position: absolute;
      inset: 0;
      width: 13px;
      height: 13px;
      border: 2px solid rgba(136, 136, 160, 0.2);
      border-top-color: var(--fc-text-dim);
      border-radius: 50%;
      opacity: 0;
      animation: demo-spinner-vis 12s linear infinite, demo-spin 0.7s linear infinite;
    }

    /* Checkmark (appears after spinner) */
    .fc-demo-check {
      position: absolute;
      inset: 0;
      opacity: 0;
      animation: demo-check-vis 12s ease-out infinite;
    }

    /* Step 1: offset 5% = 0.6s */
    .fc-demo-step--1 { animation-delay: 0.6s; }
    .fc-demo-step--1 .fc-demo-spinner { animation-delay: 0.6s, 0s; }
    .fc-demo-step--1 .fc-demo-check { animation-delay: 0.6s; }

    /* Step 2: offset 15% = 1.8s */
    .fc-demo-step--2 { animation-delay: 1.8s; }
    .fc-demo-step--2 .fc-demo-spinner { animation-delay: 1.8s, 0s; }
    .fc-demo-step--2 .fc-demo-check { animation-delay: 1.8s; }

    /* Step 3: offset 25% = 3.0s */
    .fc-demo-step--3 { animation-delay: 3.0s; }
    .fc-demo-step--3 .fc-demo-spinner { animation-delay: 3.0s, 0s; }
    .fc-demo-step--3 .fc-demo-check { animation-delay: 3.0s; }

    /* Step 4: offset 38% = 4.56s */
    .fc-demo-step--4 { animation-delay: 4.56s; }
    .fc-demo-step--4 .fc-demo-spinner { animation-delay: 4.56s, 0s; }
    .fc-demo-step--4 .fc-demo-check { animation-delay: 4.56s; }

    /* Step 5: offset 48% = 5.76s */
    .fc-demo-step--5 { animation-delay: 5.76s; }
    .fc-demo-step--5 .fc-demo-spinner { animation-delay: 5.76s, 0s; }
    .fc-demo-step--5 .fc-demo-check { animation-delay: 5.76s; }

    /* Step lifecycle: fade in -> visible -> fade out */
    @keyframes demo-step-lifecycle {
      0% { opacity: 0; transform: translateX(-6px); }
      5% { opacity: 1; transform: translateX(0); }
      85% { opacity: 1; }
      92% { opacity: 0; }
      100% { opacity: 0; }
    }

    /* Spinner visible for the first ~10% of step life, then hidden */
    @keyframes demo-spinner-vis {
      0% { opacity: 0; }
      2% { opacity: 1; }
      10% { opacity: 1; }
      12% { opacity: 0; }
      100% { opacity: 0; }
    }

    @keyframes demo-spin {
      to { transform: rotate(360deg); }
    }

    /* Check appears after spinner disappears */
    @keyframes demo-check-vis {
      0% { opacity: 0; transform: scale(0.5); }
      10% { opacity: 0; transform: scale(0.5); }
      14% { opacity: 1; transform: scale(1); }
      85% { opacity: 1; }
      92% { opacity: 0; }
      100% { opacity: 0; }
    }

    /* ─── VERDICT BADGE ─── */
    .fc-demo-verdict {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      background: rgba(239, 68, 68, 0.06);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: 10px;
      opacity: 0;
      animation: demo-verdict-in 12s ease-out 6.8s infinite;
    }

    .fc-demo-verdict-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fc-accent-red);
    }

    .fc-demo-verdict-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--fc-accent-red);
      box-shadow: 0 0 8px var(--fc-accent-red);
    }

    .fc-demo-verdict-conf {
      font-family: 'DM Mono', monospace;
      font-size: 0.68rem;
      color: var(--fc-text-dim);
      letter-spacing: 0.04em;
    }

    @keyframes demo-verdict-in {
      0% { opacity: 0; transform: translateY(6px) scale(0.97); }
      5% { opacity: 1; transform: translateY(0) scale(1); }
      78% { opacity: 1; }
      85% { opacity: 0; }
      100% { opacity: 0; }
    }

    @media (max-width: 640px) {
      .fc-landing-wrapper { padding: 1.25rem 1rem 3rem; }

      .fc-hero { padding: 3.5rem 0 3rem; }

      .fc-hero-radar { width: 400px; height: 400px; }

      .fc-hero-ctas { flex-direction: column; gap: 0.75rem; }
      .fc-cta-primary,
      .fc-cta-secondary { width: 100%; justify-content: center; }

      .fc-hero-proof { flex-direction: column; gap: 0.6rem; }

      .fc-demo-card { padding: 1.1rem; }
      .fc-demo-message { padding: 0.85rem 0.9rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .fc-radar-ring,
      .fc-radar-sweep,
      .fc-hero-eyebrow,
      .fc-hero-eyebrow-dot,
      .fc-hero-headline,
      .fc-hero-sub,
      .fc-hero-ctas,
      .fc-hero-proof,
      .fc-demo-message,
      .fc-demo-step,
      .fc-demo-spinner,
      .fc-demo-check,
      .fc-demo-verdict {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
