<style>
    :root {
      --fc-bg: #0a0a0f;
      --fc-surface: #12121a;
      --fc-surface-raised: #1a1a26;
      --fc-border: #2a2a3a;
      --fc-text: #e8e8ef;
      --fc-text-muted: #8888a0;
      --fc-text-dim: #55556a;
      --fc-accent-green: #22c55e;
      --fc-accent-amber: #eab308;
      --fc-accent-gray: #6b7280;
      --fc-accent-red: #ef4444;
      --fc-accent-purple: #a855f7;
      --fc-accent-blue: #3b82f6;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--fc-bg);
      color: var(--fc-text);
      font-family: 'Satoshi', -apple-system, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    .fc-landing-wrapper {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }

    /* ─── TOPBAR ─── */
    .fc-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--fc-border);
      margin-bottom: 2.5rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      color: var(--fc-text-dim);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .fc-topbar-brand {
      color: var(--fc-text-muted);
      font-weight: 500;
      text-decoration: none;
    }

    .fc-topbar-link {
      color: var(--fc-text-dim);
      text-decoration: none;
      transition: color 0.2s;
    }

    .fc-topbar-link:hover {
      color: var(--fc-text-muted);
    }

    @media (max-width: 640px) {
      .fc-landing-wrapper { padding: 1.25rem 1rem 3rem; }
    }
  </style>
