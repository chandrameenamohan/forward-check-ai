<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Investigation — ForwardCheck</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Satoshi:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2l12 7v9c0 7-5 13-12 16C9 31 4 25 4 18V9l12-7z' fill='%230a0a0f' stroke='%2322c55e' stroke-width='2'/%3E%3Cpath d='M11 16l3 3 7-7' fill='none' stroke='%2322c55e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <%- include('_live-styles') %>
</head>
<body>
  <div class="fc-live-wrapper">

    <div class="fc-topbar">
      <span class="fc-topbar-brand">ForwardCheck</span>
      <span class="fc-topbar-id">#<%= id.slice(0, 8) %></span>
    </div>

    <!-- ═══ STATUS HEADER ═══ -->
    <div class="fc-live-status">
      <div class="fc-live-status-badge">
        <span class="fc-live-status-dot"></span>
        <span>Live Investigation</span>
      </div>
      <h1 class="fc-live-headline">Your Claim, Under the Microscope</h1>
      <p class="fc-live-subtitle">Six AI agents are about to tear this apart. Watch them work.</p>
    </div>

    <!-- ═══ ORIGINAL MESSAGE ═══ -->
    <div class="fc-live-message">
      <div class="fc-live-message-label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
        Forwarded claim
      </div>
      <p class="fc-live-message-text"><%= originalMessage %></p>
    </div>

    <!-- ═══ PIPELINE VISUALIZATION AREA ═══ -->
    <div class="fc-live-pipeline" id="fc-pipeline-area">
      <div class="fc-connecting-spinner" id="fc-connecting-spinner">
        <div class="fc-connecting-spinner-ring"></div>
        <span>Connecting to investigation...</span>
      </div>

      <!-- Agent cards injected here by JS event handlers -->
      <div id="fc-agent-cards" class="fc-agent-cards"></div>

      <!-- Error / status messages -->
      <div id="fc-pipeline-status" class="fc-pipeline-status" style="display:none;"></div>
    </div>

  </div>

  <script>
    (function() {
      var investigationId = '<%= id %>';
      var evtSource = new EventSource('/api/live/' + investigationId + '/stream');
      var spinner = document.getElementById('fc-connecting-spinner');
      var statusEl = document.getElementById('fc-pipeline-status');

      // ── Hide spinner on first event ──
      var spinnerHidden = false;
      function hideSpinner() {
        if (!spinnerHidden && spinner) {
          spinner.style.display = 'none';
          spinnerHidden = true;
        }
      }

      function showStatus(text, type) {
        if (statusEl) {
          statusEl.textContent = text;
          statusEl.className = 'fc-pipeline-status fc-pipeline-status--' + (type || 'info');
          statusEl.style.display = 'block';
        }
      }

      // ── UI update stubs — Phase 3 will flesh these out ──

      function updateClassifier(kind, data) {
        hideSpinner();
        // Stub: will render classifier agent card in Task 3.2
      }

      function updateStrategist(kind, data) {
        hideSpinner();
        // Stub: will render strategist agent card in Task 3.2
      }

      function updateInvestigators(kind, data) {
        hideSpinner();
        // Stub: will render investigator cards in Task 3.3
      }

      function updateDA(kind, data) {
        hideSpinner();
        // Stub: will render DA card in Task 3.4
      }

      function updateJudge(kind, data) {
        hideSpinner();
        // Stub: will render judge card / verdict in Task 3.5
      }

      // ── Pipeline lifecycle events ──

      evtSource.addEventListener('pipeline:start', function(e) {
        hideSpinner();
      });

      // ── Classifier events ──

      evtSource.addEventListener('classifier:start', function(e) {
        var data = JSON.parse(e.data);
        updateClassifier('start', data);
      });

      evtSource.addEventListener('classifier:complete', function(e) {
        var data = JSON.parse(e.data);
        updateClassifier('complete', data);
      });

      // ── Strategist events ──

      evtSource.addEventListener('strategist:start', function(e) {
        var data = JSON.parse(e.data);
        updateStrategist('start', data);
      });

      evtSource.addEventListener('strategist:complete', function(e) {
        var data = JSON.parse(e.data);
        updateStrategist('complete', data);
      });

      // ── Investigator events ──

      evtSource.addEventListener('investigators:start', function(e) {
        var data = JSON.parse(e.data);
        updateInvestigators('start', data);
      });

      evtSource.addEventListener('investigator:searching', function(e) {
        var data = JSON.parse(e.data);
        updateInvestigators('searching', data);
      });

      evtSource.addEventListener('investigator:complete', function(e) {
        var data = JSON.parse(e.data);
        updateInvestigators('complete', data);
      });

      // ── Disagreement detection ──

      evtSource.addEventListener('disagreement:detected', function(e) {
        var data = JSON.parse(e.data);
        updateInvestigators('disagreement', data);
      });

      // ── Devil's Advocate events ──

      evtSource.addEventListener('da:start', function(e) {
        var data = JSON.parse(e.data);
        updateDA('start', data);
      });

      evtSource.addEventListener('da:complete', function(e) {
        var data = JSON.parse(e.data);
        updateDA('complete', data);
      });

      // ── Judge events ──

      evtSource.addEventListener('judge:start', function(e) {
        var data = JSON.parse(e.data);
        updateJudge('start', data);
      });

      evtSource.addEventListener('judge:complete', function(e) {
        var data = JSON.parse(e.data);
        updateJudge('complete', data);
      });

      // ── Pipeline complete — verdict reveal + redirect ──

      evtSource.addEventListener('pipeline:complete', function(e) {
        var data = JSON.parse(e.data);
        hideSpinner();
        updateJudge('verdict', data);
        evtSource.close();

        var countdown = 5;
        showStatus('Full analysis ready in ' + countdown + '...', 'success');

        var timer = setInterval(function() {
          countdown--;
          if (countdown <= 0) {
            clearInterval(timer);
            window.location.href = '/v/' + investigationId;
          } else {
            showStatus('Full analysis ready in ' + countdown + '...', 'success');
          }
        }, 1000);
      });

      // ── Pipeline error ──

      evtSource.addEventListener('pipeline:error', function(e) {
        var data = JSON.parse(e.data);
        hideSpinner();
        showStatus('Something went wrong: ' + (data.error || 'Unknown error'), 'error');
        evtSource.close();
      });

      // ── Connection error — reconnect handled by EventSource ──

      evtSource.onerror = function() {
        showStatus('Connection lost. Reconnecting...', 'warning');
      };

      // Restore status when connection reopens
      evtSource.onopen = function() {
        if (statusEl && statusEl.textContent === 'Connection lost. Reconnecting...') {
          statusEl.style.display = 'none';
        }
      };
    })();
  </script>
</body>
</html>
