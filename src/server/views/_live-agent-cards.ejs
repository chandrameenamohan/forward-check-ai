<!-- Classifier card -->
<div class="fc-agent-card fc-agent-card--classifier fc-agent--idle" id="fc-card-classifier">
  <div class="fc-agent-card-header">
    <div class="fc-agent-icon fc-agent-icon--classifier">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 12l4-4"/><circle cx="12" cy="12" r="3"/></svg>
    </div>
    <div class="fc-agent-card-title">
      <span class="fc-agent-name">Classifier</span>
      <span class="fc-model-badge fc-model-badge--haiku">Haiku</span>
    </div>
    <div class="fc-agent-check" id="fc-classifier-check">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
  </div>
  <div class="fc-agent-status" id="fc-classifier-status">Waiting to scan your message</div>
  <div class="fc-agent-result" id="fc-classifier-result" style="display:none;"></div>
</div>

<div class="fc-connector-line"></div>

<!-- Strategist card -->
<div class="fc-agent-card fc-agent-card--strategist fc-agent--idle" id="fc-card-strategist">
  <div class="fc-agent-card-header">
    <div class="fc-agent-icon fc-agent-icon--strategist">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    </div>
    <div class="fc-agent-card-title">
      <span class="fc-agent-name">Strategist</span>
      <span class="fc-model-badge fc-model-badge--opus">Opus 4.6</span>
    </div>
    <div class="fc-agent-check" id="fc-strategist-check">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
  </div>
  <div class="fc-agent-status" id="fc-strategist-status">Waiting for the game plan</div>
  <div class="fc-agent-result" id="fc-strategist-result" style="display:none;"></div>
  <div class="fc-agent-thinking" id="fc-strategist-thinking" style="display:none;">
    <span class="fc-agent-thinking-label">AI Reasoning</span>
    <p class="fc-agent-thinking-text" id="fc-strategist-thinking-text"></p>
  </div>
</div>
