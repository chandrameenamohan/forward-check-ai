<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feedback — ForwardCheck-AI</title>
  <meta name="description" content="Report a bug, share feedback, or request a feature for ForwardCheck-AI.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Satoshi:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2l12 7v9c0 7-5 13-12 16C9 31 4 25 4 18V9l12-7z' fill='%230a0a0f' stroke='%2322c55e' stroke-width='2'/%3E%3Cpath d='M11 16l3 3 7-7' fill='none' stroke='%2322c55e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <%- include('_feedback-styles') %>
</head>
<body>

  <div class="fc-feedback-wrapper">

    <nav class="fc-topbar">
      <a class="fc-topbar-brand" href="/">ForwardCheck</a>
      <a class="fc-topbar-link" href="/">Home</a>
    </nav>

    <main>
      <!-- ═══ HEADER ═══ -->
      <div class="fc-feedback-header">
        <h1 class="fc-feedback-headline">Report a Bug or Share Feedback</h1>
        <p class="fc-feedback-subtitle">Found something broken? Have an idea? We read every submission.</p>
      </div>

      <!-- ═══ FORM CARD ═══ -->
      <div class="fc-feedback-card" id="fc-feedback-form-card">
        <form id="fc-feedback-form" novalidate>

          <!-- Type selector -->
          <span class="fc-feedback-type-label">What kind of feedback?</span>
          <div class="fc-feedback-type-group" role="radiogroup" aria-label="Feedback type">
            <input type="radio" name="type" value="bug" id="fc-type-bug" checked>
            <label for="fc-type-bug" class="fc-feedback-type-option">
              <span class="fc-feedback-type-emoji">🐛</span> Bug
            </label>

            <input type="radio" name="type" value="feedback" id="fc-type-feedback">
            <label for="fc-type-feedback" class="fc-feedback-type-option">
              <span class="fc-feedback-type-emoji">💬</span> Feedback
            </label>

            <input type="radio" name="type" value="feature" id="fc-type-feature">
            <label for="fc-type-feature" class="fc-feedback-type-option">
              <span class="fc-feedback-type-emoji">✨</span> Feature
            </label>
          </div>

          <!-- Title -->
          <div class="fc-feedback-field">
            <label for="fc-feedback-title" class="fc-feedback-field-label">Title</label>
            <input
              type="text"
              id="fc-feedback-title"
              class="fc-feedback-input"
              placeholder="What's this about?"
              minlength="5"
              maxlength="200"
              required
              autocomplete="off"
            >
          </div>

          <!-- Description -->
          <div class="fc-feedback-field">
            <label for="fc-feedback-desc" class="fc-feedback-field-label">Description</label>
            <textarea
              id="fc-feedback-desc"
              class="fc-feedback-input fc-feedback-textarea"
              placeholder="Tell us more..."
              minlength="10"
              maxlength="5000"
              required
            ></textarea>
            <span class="fc-feedback-counter" id="fc-feedback-counter" aria-live="polite">0 / 5,000</span>
          </div>

          <!-- Submit -->
          <button type="submit" class="fc-feedback-submit" id="fc-feedback-submit" disabled>
            <span class="fc-feedback-submit-text">Submit Feedback</span>
            <span class="fc-feedback-spinner" aria-hidden="true"></span>
          </button>

          <!-- Error -->
          <div class="fc-feedback-error" id="fc-feedback-error" role="alert"></div>
        </form>
      </div>

      <!-- ═══ SUCCESS STATE ═══ -->
      <div class="fc-feedback-card fc-feedback-success" id="fc-feedback-success">
        <div class="fc-feedback-success-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="fc-feedback-success-title">Feedback submitted!</div>
        <p class="fc-feedback-success-body">Thanks for helping improve ForwardCheck. We review every report.</p>
        <a class="fc-feedback-issue-link" id="fc-feedback-issue-link" href="#" target="_blank" rel="noopener noreferrer" style="display:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View on GitHub
        </a>
        <button type="button" class="fc-feedback-reset" id="fc-feedback-reset">Submit another</button>
      </div>

    </main>
  </div>

  <script>
  (function() {
    var form = document.getElementById('fc-feedback-form');
    var formCard = document.getElementById('fc-feedback-form-card');
    var titleInput = document.getElementById('fc-feedback-title');
    var descInput = document.getElementById('fc-feedback-desc');
    var counter = document.getElementById('fc-feedback-counter');
    var submitBtn = document.getElementById('fc-feedback-submit');
    var errorEl = document.getElementById('fc-feedback-error');
    var successEl = document.getElementById('fc-feedback-success');
    var issueLink = document.getElementById('fc-feedback-issue-link');
    var resetBtn = document.getElementById('fc-feedback-reset');

    var TITLE_MIN = 5;
    var DESC_MIN = 10;
    var DESC_MAX = 5000;
    var submitting = false;

    function getSelectedType() {
      var checked = document.querySelector('input[name="type"]:checked');
      return checked ? checked.value : 'bug';
    }

    function updateCounter() {
      var len = descInput.value.length;
      counter.textContent = len.toLocaleString() + ' / 5,000';
      counter.classList.toggle('fc-feedback-counter--warn', len > 0 && len < DESC_MIN);
      counter.classList.toggle('fc-feedback-counter--over', len > DESC_MAX);
    }

    function updateSubmitState() {
      var titleLen = titleInput.value.trim().length;
      var descLen = descInput.value.trim().length;
      submitBtn.disabled = submitting || titleLen < TITLE_MIN || descLen < DESC_MIN || descInput.value.length > DESC_MAX;
    }

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
    }

    function hideError() {
      errorEl.style.display = 'none';
      errorEl.textContent = '';
    }

    titleInput.addEventListener('input', function() {
      hideError();
      updateSubmitState();
    });

    descInput.addEventListener('input', function() {
      hideError();
      updateCounter();
      updateSubmitState();
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      if (submitting) return;

      hideError();

      var title = titleInput.value.trim();
      var desc = descInput.value.trim();
      var type = getSelectedType();

      if (title.length < TITLE_MIN) {
        showError('Title must be at least ' + TITLE_MIN + ' characters.');
        return;
      }
      if (desc.length < DESC_MIN) {
        showError('Description must be at least ' + DESC_MIN + ' characters.');
        return;
      }

      submitting = true;
      submitBtn.disabled = true;
      submitBtn.classList.add('fc-feedback-submit--loading');

      fetch('/api/feedback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: type, title: title, description: desc }),
      })
      .then(function(res) {
        if (res.status === 429) {
          var retryAfter = res.headers.get('retry-after') || '60';
          showError('Too many submissions. Try again in ' + retryAfter + ' seconds.');
          submitting = false;
          submitBtn.classList.remove('fc-feedback-submit--loading');
          updateSubmitState();
          return null;
        }
        return res.json();
      })
      .then(function(data) {
        if (!data) return;

        if (data.error) {
          showError(data.error);
          submitting = false;
          submitBtn.classList.remove('fc-feedback-submit--loading');
          updateSubmitState();
          return;
        }

        // Success
        formCard.style.display = 'none';
        successEl.style.display = 'block';

        if (data.githubIssueUrl) {
          issueLink.href = data.githubIssueUrl;
          issueLink.style.display = 'inline-flex';
        }
      })
      .catch(function() {
        showError('Something went wrong. Check your connection and try again.');
        submitting = false;
        submitBtn.classList.remove('fc-feedback-submit--loading');
        updateSubmitState();
      });
    });

    resetBtn.addEventListener('click', function() {
      form.reset();
      titleInput.value = '';
      descInput.value = '';
      updateCounter();
      submitting = false;
      submitBtn.classList.remove('fc-feedback-submit--loading');
      updateSubmitState();
      hideError();
      successEl.style.display = 'none';
      issueLink.style.display = 'none';
      issueLink.href = '#';
      formCard.style.display = 'block';
      titleInput.focus();
    });

    // Keyboard shortcut: Ctrl/Cmd+Enter to submit
    form.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && !submitBtn.disabled) {
        e.preventDefault();
        form.dispatchEvent(new Event('submit'));
      }
    });
  })();
  </script>
</body>
</html>
